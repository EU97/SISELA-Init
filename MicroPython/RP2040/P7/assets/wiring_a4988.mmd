graph LR
    subgraph RP2040["🔷 RP2040 (Raspberry Pi Pico)"]
        GP18[GP18 STEP]
        GP19[GP19 DIR]
        GP5[GP5 ENABLE]
        GND_RP[GND]
    end
    
    subgraph A4988["⚙️ Driver A4988/DRV8825"]
        STEP_PIN[STEP]
        DIR_PIN[DIR]
        EN_PIN[ENABLE]
        GND_DRV[GND]
        VMOT[VMOT]
        A1[A1]
        A2[A2]
        B1[B1]
        B2[B2]
    end
    
    subgraph MOTOR["🔩 Motor NEMA 17"]
        COIL_A1[Coil A+]
        COIL_A2[Coil A-]
        COIL_B1[Coil B+]
        COIL_B2[Coil B-]
    end
    
    subgraph POWER["⚡ Fuente Externa 12V"]
        V12[+12V]
        GND_PWR[GND]
    end
    
    GP18 -->|Pulso de paso| STEP_PIN
    GP19 -->|Dirección| DIR_PIN
    GP5 -->|Activo LOW| EN_PIN
    GND_RP -->|⚠️ GND COMÚN| GND_DRV
    
    V12 -->|12V/2A| VMOT
    GND_PWR -->|⚠️ GND COMÚN| GND_DRV
    
    A1 --> COIL_A1
    A2 --> COIL_A2
    B1 --> COIL_B1
    B2 --> COIL_B2
    
    style RP2040 fill:#1e90ff,stroke:#000,stroke-width:2px,color:#fff
    style A4988 fill:#ff6347,stroke:#000,stroke-width:2px,color:#fff
    style MOTOR fill:#32cd32,stroke:#000,stroke-width:2px,color:#fff
    style POWER fill:#ffd700,stroke:#000,stroke-width:2px,color:#000
    
    classDef critical fill:#ff0000,stroke:#000,stroke-width:3px,color:#fff
    class GND_RP,GND_DRV,GND_PWR critical

