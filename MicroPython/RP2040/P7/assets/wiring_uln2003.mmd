graph LR
    subgraph RP2040["🔷 RP2040 (Raspberry Pi Pico)"]
        GP26[GP26 IN1]
        GP27[GP27 IN2]
        GP28[GP28 IN3]
        GP22[GP22 IN4]
        VSYS[VSYS 5V]
        GND_RP[GND]
    end
    
    subgraph ULN2003["⚙️ Driver ULN2003"]
        IN1[IN1]
        IN2[IN2]
        IN3[IN3]
        IN4[IN4]
        VCC[VCC +]
        GND_DRV[GND -]
    end
    
    subgraph MOTOR["🔩 Motor 28BYJ-48"]
        CONNECTOR[Conector 5 pines]
    end
    
    GP26 -->|Fase 1| IN1
    GP27 -->|Fase 2| IN2
    GP28 -->|Fase 3| IN3
    GP22 -->|Fase 4| IN4
    
    VSYS -->|5V <500mA| VCC
    GND_RP -->|GND común| GND_DRV
    
    ULN2003 -->|Cable 5 pines| CONNECTOR
    
    style RP2040 fill:#1e90ff,stroke:#000,stroke-width:2px,color:#fff
    style ULN2003 fill:#ff6347,stroke:#000,stroke-width:2px,color:#fff
    style MOTOR fill:#32cd32,stroke:#000,stroke-width:2px,color:#fff
    
    classDef warning fill:#ffa500,stroke:#000,stroke-width:3px,color:#000
    class GP22 warning

