%% Mermaid wiring diagram — RP2040 P8 (A4988 variant)
flowchart LR
  subgraph MCU[RP2040]
    GP26[GP26 ADC0 Altitude]
    GP27[GP27 ADC1 Speed]
    GP28[GP28 ADC2 Attitude]
    TEMP["ADC4 TEMP (Light)"]
    GP14[GP14 Servo Aileron]
    GP15[GP15 Servo Elevator]
    GP13[GP13 PWM Motor]
    GP18[GP18 STEP]
    GP19[GP19 DIR]
    GP5[GP5 EN]
    GP4[GP4 Endstop]
  end

  subgraph SERVOS["Servos 5V (fuente externa)"]
    S1[Servo Aileron]
    S2[Servo Elevator]
  end

  subgraph PWMDRIVE[Etapa PWM Motor]
    MOSFET[ MOSFET N-Channel ]
    MOTOR[ Motor DC / Carga ]
    DIODE[Diodo Flyback]
    VEXT[+V Motor]
  end

  subgraph STEPPER[A4988 Driver + NEMA17]
    ASTEP[STEP]
    ADIR[DIR]
    AEN["EN (LOW=ON)"]
    VMOT[VMOT 12V]
    GNDST[GND]
    MTR[NEMA 17]
  end

  subgraph SENS[Potenciómetros / Sensores]
    ALT[Altitud Pot]
    SPD[Velocidad Pot]
    ATT[Actitud Pot]
  end

  subgraph ENDSTOP["Endstop (NO → GND)"]
    SW[Micro switch]
  end

  %% ADC connections
  ALT -- 0-3.3V --> GP26
  SPD -- 0-3.3V --> GP27
  ATT -- 0-3.3V --> GP28
  TEMP -. interno .- MCU

  %% Servos signal
  GP14 -- señal --> S1
  GP15 -- señal --> S2

  %% PWM motor
  GP13 -- Gate --> MOSFET
  VEXT --> MOTOR
  MOTOR -- a Dreno --> MOSFET
  DIODE -. "flyback en paralelo" .- MOTOR

  %% Stepper driver control
  GP18 --> ASTEP
  GP19 --> ADIR
  GP5  --> AEN
  VMOT -. 12V externa .- STEPPER
  MTR --- STEPPER

  %% Endstop
  GP4 -- PULL_UP --> SW
  SW -- Activo a GND --> GNDST

  %% Commons and grounds
  subgraph PWR[Fuentes y GND]
    GND[ GND común ]
    V5[ +5V Servos ]
    V12[ +12V VMOT ]
  end

  SERVOS --- V5
  PWMDRIVE --- VEXT
  STEPPER --- V12
  MCU --- GND
  SERVOS --- GND
  PWMDRIVE --- GND
  STEPPER --- GND
  ENDSTOP --- GND
