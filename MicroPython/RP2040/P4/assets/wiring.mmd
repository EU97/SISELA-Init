flowchart LR
    subgraph RP2040["Raspberry Pi Pico (RP2040)"]
        GP26["GP26<br/>(ADC0)<br/>16bit, 0-3.3V"]
        VCC["3V3(OUT)"]
        GND_RP["GND"]
        VSYS["VSYS<br/>(5V USB)"]
    end
    
    subgraph MPX5500DP["MPX5500DP Sensor<br/>SOT-223 Package"]
        PIN1["Pin 1: GND"]
        PIN2["Pin 2: VS<br/>(4.75-5.25V)"]
        PIN3["Pin 3: Vout<br/>(0.66-3.3V)"]
    end
    
    subgraph Optional["Circuito Opcional<br/>(para VS=5V)"]
        R1["R1: 10kΩ"]
        R2["R2: 10kΩ"]
        DIV["Divisor<br/>5V → 2.5V"]
    end
    
    VCC -->|"3.3V"| PIN2
    GND_RP -->|"GND"| PIN1
    PIN3 -->|"Vout<br/>0.66-3.3V"| GP26
    
    VSYS -.->|"Alternativa:<br/>5V desde USB"| DIV
    PIN2 -.->|"Con VSYS"| DIV
    PIN3 -.->|"Con VS=5V<br/>usar divisor"| R1
    R1 -.-> R2
    R2 -.->|"GND"| GND_RP
    R1 -.->|"2.5V máx"| GP26
    
