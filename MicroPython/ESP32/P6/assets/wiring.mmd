%% Diagrama de cableado — P6 OLED SSD1306 (+ BMP280 opcional)
flowchart LR
    subgraph ESP32
      SDA21[GPIO21 (SDA)]
      SCL22[GPIO22 (SCL)]
      V33[3.3V]
      GND0[GND]
    end

    subgraph OLED[OLED SSD1306 128x64]
      OSDA[SDA]
      OSCL[SCL]
      OVCC[VCC 3.3V]
      OGND[GND]
    end

    subgraph BMP[BMP280 (opcional)]
      BSDA[SDA]
      BSCL[SCL]
      BVCC[VCC 3.3V]
      BGND[GND]
    end

    SDA21 -- SDA --> OSDA
    SCL22 -- SCL --> OSCL
    V33 -- 3.3V --> OVCC
    GND0 -- GND --> OGND

    SDA21 -- SDA --> BSDA
    SCL22 -- SCL --> BSCL
    V33 -- 3.3V --> BVCC
    GND0 -- GND --> BGND

    classDef note fill:#fff9c4,stroke:#bdb76b,color:#333;
    N1([Ambos dispositivos comparten el bus I2C (SDA/SCL)]):::note
    N2([Direcciones típicas: OLED 0x3C, BMP280 0x76/0x77]):::note
