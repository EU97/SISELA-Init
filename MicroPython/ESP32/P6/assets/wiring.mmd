%% Diagrama de cableado — P6 Conmutación de potencia (PWM + transistor)
flowchart TB
  subgraph ESP32
    PWM18["GPIO18 (PWM)"] --> Rg[Res 220 Ω]
    ADC34["GPIO34 (ADC) opcional"]
    GNDuC[GND]
  end

  Rg --> G[Gate/Base]
  D[Drain/Colector] --> LOAD[Carga]
  LOAD --> VPLUS["+V (5–12 V)"]
  S[Source/Emisor] --> GNDp[GND fuente]
  GNDuC --- GNDp

  %% Diodo flyback para cargas inductivas
  VPLUS -->|"Diodo flyback"| D

  classDef opt fill:#eef,stroke:#99f,color:#000;
  ADC34:::opt

  classDef note fill:#fff9c4,stroke:#bdb76b,color:#333;
  N1([GND común entre ESP32 y la fuente externa es obligatorio]):::note
  N2([No alimentes la carga desde 3V3 del ESP32]):::note
