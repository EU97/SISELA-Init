flowchart LR
    subgraph ESP32["ESP32 DevKit"]
        GPIO34["GPIO34<br/>(ADC1_CH6)<br/>12bit, ATTN_11DB"]
        VCC["3V3"]
        GND_ESP["GND"]
    end
    
    subgraph MPX5500DP["MPX5500DP Sensor<br/>SOT-223 Package"]
        PIN1["Pin 1: GND"]
        PIN2["Pin 2: VS<br/>(4.75-5.25V)"]
        PIN3["Pin 3: Vout<br/>(0.66-3.3V)"]
    end
    
    subgraph Optional["Circuito Opcional<br/>(para VS=5V)"]
        R1["R1: 10kΩ"]
        R2["R2: 10kΩ"]
        DIV["Divisor<br/>5V → 2.5V"]
    end
    
    VCC -->|"3.3V"| PIN2
    GND_ESP -->|"GND"| PIN1
    PIN3 -->|"Vout<br/>0.66-3.3V"| GPIO34
    
    PIN2 -.->|"Alternativa:<br/>5V regulado"| DIV
    PIN3 -.->|"Con VS=5V<br/>usar divisor"| R1
    R1 -.-> R2
    R2 -.->|"GND"| GND_ESP
    R1 -.->|"2.5V máx"| GPIO34
    
    style GPIO34 fill:#90EE90
    style PIN3 fill:#FFD700
